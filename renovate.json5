{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      // Update manually to match our main target builds for easy testing
      // AGP cannot have multiple versions in the same build
      "matchPackageNames": [
        "com.android.tools.build:**",
      ],
      "enabled": false
    },
    {
      // Renovate thinks versions like 0.7.1-0.6.x-compat are newer than 0.7.1
      "matchPackageNames": [
        "org.jetbrains.kotlinx:kotlinx-datetime"
      ],
      "allowedVersions": "!/-compat$/",
    },
    {
      // OkHttp must stay at 4.x for IntelliJ Platform plugin compatibility
      // The plugin-repository-rest-client library is compiled against OkHttp 4.x
      // and is not compatible with OkHttp 5.x (NoSuchFieldError: Companion)
      "matchPackageNames": [
        "com.squareup.okhttp3:okhttp"
      ],
      "allowedVersions": "< 5.0",
    }
  ]
}
