<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
  <id>xyz.block.artifactswap</id>
  <name>Artifact Swap</name>
  <vendor url="https://github.com/block/artifact-swap">Block</vendor>
  <description><![CDATA[
Artifact Swap intercepts navigation to classes inside binary artifacts (JARs/AARs) that are known
to be swapped-out project modules. Instead of navigating to the decompiled class file inside the
artifact, it redirects to the actual source file in your project.

This plugin works in conjunction with the
<a href="https://plugins.gradle.org/plugin/xyz.block.artifactswap">Artifact Swap Gradle plugin</a>.
]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>
  <depends>com.intellij.gradle</depends>
  <depends>org.jetbrains.kotlin</depends>

  <!-- Optional dependency for Android resource navigation support -->
  <depends optional="true">org.jetbrains.android</depends>

  <!-- Artifact Swap builds on top of Spotlight -->
  <depends>com.fueledbycaffeine.spotlight</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Notification group for balloon popups -->
    <notificationGroup
        id="Artifact Swap Notifications"
        displayType="BALLOON"/>

    <!-- Editor notification banner when viewing a swapped artifact file -->
    <editorNotificationProvider
        implementation="xyz.block.artifactswap.idea.notification.SwappedArtifactNotificationProvider"/>

    <!-- Intercept go-to-declaration navigation -->
    <gotoDeclarationHandler
        implementation="xyz.block.artifactswap.idea.navigation.ArtifactSwapGotoDeclarationHandler"
        order="first"/>

    <!-- Settings page -->
    <applicationConfigurable
        parentId="tools"
        instance="xyz.block.artifactswap.idea.settings.ArtifactSwapSettingsConfigurable"
        id="xyz.block.artifactswap.settings"
        displayName="Artifact Swap"/>

    <!-- Settings state service -->
    <applicationService
        serviceImplementation="xyz.block.artifactswap.idea.settings.ArtifactSwapSettings"/>

    <!-- External system data service for processing Gradle sync data -->
    <externalProjectDataService
        implementation="xyz.block.artifactswap.idea.gradle.ArtifactSwapModelDataService"/>

    <!-- Suppress Gradle inspections for valid project references not loaded in IDE -->
    <lang.inspectionSuppressor
        language="kotlin"
        implementationClass="xyz.block.artifactswap.idea.gradle.GradleBuildFileInspectionSuppressor"/>
    <lang.inspectionSuppressor
        language="Groovy"
        implementationClass="xyz.block.artifactswap.idea.gradle.GradleBuildFileInspectionSuppressor"/>
  </extensions>

  <!-- Gradle integration -->
  <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
    <projectResolve
        implementation="xyz.block.artifactswap.idea.gradle.ArtifactSwapProjectResolverExtension"/>
  </extensions>

  <!-- File editor listener for showing popup notifications -->
  <projectListeners>
    <listener
        class="xyz.block.artifactswap.idea.notification.SwappedArtifactFileEditorListener"
        topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
  </projectListeners>

  <!-- Declare compatibility with Kotlin K2 mode -->
  <extensions defaultExtensionNs="org.jetbrains.kotlin">
    <supportsKotlinPluginMode supportsK2="true"/>
  </extensions>
</idea-plugin>
